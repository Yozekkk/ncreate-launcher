{
	"compilerOptions": {
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"lib": [
			"ES2021",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"vite/client"
		],
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.vue"
	]
}
