{
	"name": "@ncreate/app-frontend",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"typecheck": "vue-tsc --noEmit",
		"lint": "eslint src && prettier --check src tests",
		"check": "vue-tsc --noEmit && eslint src && prettier --check src tests && pnpm test",
		"fix": "eslint src --fix && prettier --write src tests",
		"test": "node --experimental-strip-types --test tests/*.test.mjs"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-autostart": "^2.5.1",
		"dompurify": "^3.4.16",
		"lucide-vue-next": "^0.468.0",
		"markdown-it": "^15.0.2",
		"vue": "^3.5.30",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@types/markdown-it": "^14.2.0",
		"@vitejs/plugin-vue": "^6.0.3",
		"eslint": "^9.39.4",
		"eslint-plugin-vue": "^10.8.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^8.0.0",
		"vue-tsc": "^3.2.6"
	}
}
